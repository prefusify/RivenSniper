# RivenSniper 配置示例。复制为 .env 后按需修改（.env 含密钥，永不入库）。

# ---- NoneBot / SnowLuma OneBot ----
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8180
# SnowLuma 反向 WS 与 HTTP API 使用同一个鉴权 token
ONEBOT_ACCESS_TOKEN=改成随机字符串
# 反向 WS 只接收事件；全部 OneBot action 固定走 SnowLuma HTTP API。
# "*" 表示当前连接的 SnowLuma QQ 账号统一使用该地址。
ONEBOT_API_ROOTS={"*":"http://127.0.0.1:3000/"}

# ---- 紫卡狙击 ----
# 轮询间隔范围：1~3600 秒
SNIPER_POLL_INTERVAL=15.0
# 快速搜索每个独立查询的目标间隔：1~60 秒；目标开关在管理控制台设置
WM_FAST_INTERVAL=2.0
# 私有代理池与 SSH 配置；详见 README.md 的 WM 快速获取章节
WM_FAST_PROXY_CONFIG=.runtime/wm_fast_proxy.json
# 推送间隔范围：0~60 秒；0 = 推送成功后不额外等待
SNIPER_SEND_INTERVAL=0
# 主通道不同目标的全局并发上限；0 = 不额外限制
SNIPER_SEND_CONCURRENCY=0
# 统一内存发送队列；满时淘汰尚未处理的最旧消息
SEND_QUEUE_MAXSIZE=1000
# IRC / WM / 捡漏消息的最长有效时间（秒）
TRADE_MESSAGE_TTL_SECONDS=60
# 仅实际发送发生瞬时网络错误时重试
SEND_MAX_RETRIES=1
SEND_RETRY_DELAY_SECONDS=2
SNIPER_DRY_RUN=false
# 每群狙击配置数量；0 = 不限制
SNIPER_MAX_CONFIGS_PER_GROUP=0

# ---- 捡漏（低价道具/紫卡监控）----
# 道具/紫卡折扣、紫卡滚动时长和最低有效样本数统一在控制台设置
# 所有 Bot 目标共用的全局不同 slug 上限；0 = 不限制
BARGAIN_MAX_DISTINCT_SLUGS=0

# ---- Discord 官方 Bot（只处理私聊，不注册服务器命令）----
DISCORD_DM_ENABLED=false
# Discord 私聊目标由管理控制台创建和启停
# intent 必须显式关闭所有服务器事件，只保留 direct_messages
DISCORD_BOTS=[]
# 启用时把上一行替换为：
# DISCORD_BOTS=[{"token":"替换为DiscordBot令牌","intent":{"guilds":false,"guild_members":false,"guild_moderation":false,"guild_emojis_and_stickers":false,"guild_integrations":false,"guild_webhooks":false,"guild_invites":false,"guild_voice_states":false,"guild_presences":false,"guild_messages":false,"guild_message_reactions":false,"guild_message_typing":false,"direct_messages":true,"direct_message_reactions":false,"direct_message_typing":false,"message_content":false,"guild_scheduled_events":false,"auto_moderation_configuration":false,"auto_moderation_execution":false,"guild_message_polls":false,"direct_message_polls":false},"application_commands":{}}]

# ---- 游戏 IRC 分槽喂送（独立采集器写 4 个 JSONL）----
# IRC_FEED_ENABLED=true
# IRC_FEED_DIR=<仓库>\.runtime\chat_collector\feed
# IRC_FEED_CHECKPOINT_PATH=<仓库>\.runtime\chat_collector\feed_cursor.json
# 旧单文件兼容模式（与 IRC_FEED_DIR 二选一，目录优先）：
# IRC_FEED_PATH=<chat_live.jsonl 绝对路径>
# IRC_FEED_INTERVAL=0.2  # 必须大于 0
# IRC_FEED_STALE_SECONDS=180  # 必须大于 0
# 已被投递、追踪和上线游标全部消费的每日 JSONL 自动保留 7 天；0 = 永久保留。
# IRC_FEED_RETENTION_DAYS=7
# presence 原始事件和已结束会话保留 7 天；玩家、紫卡及归属历史永久保留。
# IRC_PRESENCE_RETENTION_DAYS=7
# 追踪数据库位置；玩家昵称、紫卡和归属历史长期保留
# IRC_TRACK_DB_PATH=<仓库>\.runtime\chat_collector\track.db
